# Stock Insights server — environment variable template.
#
# Setup:
#   1. Copy this file to `.env` (no extension):    copy .env.example .env
#   2. Fill in PORTFOLIO_SQL_PASSWORD below.
#   3. Run `python server.py` — server.py auto-loads .env on startup
#      (via python-dotenv from requirements.txt).
#
# `.env` itself is gitignored, so your password never leaves the server PC.
# This `.env.example` IS committed, as a "what variables do I need to set?"
# reference for future-you on a fresh checkout.

# ── Required ─────────────────────────────────────────────────────────────────
# Password for the SQL Server login (stock_app, or whichever PORTFOLIO_SQL_USER
# resolves to). Created by init_stockinsights.sql.
PORTFOLIO_SQL_PASSWORD=

# ── Optional — defaults shown ────────────────────────────────────────────────
# Override these only if your SQL Server / hostname / port differs from the
# defaults in server.py. Uncomment + edit the line(s) you want to change.

# PORTFOLIO_SQL_SERVER=localhost\STOCKINSIGHTS
# PORTFOLIO_SQL_DATABASE=StockInsights
# PORTFOLIO_SQL_USER=sa

# Host the FastAPI listener binds to. 0.0.0.0 = all interfaces (default).
# Set to 127.0.0.1 if you ONLY want localhost access (i.e. you're proxying
# behind nginx/caddy/Cloudflare Tunnel and don't want direct LAN access).
# PORTFOLIO_HOST=0.0.0.0

# TCP port the server listens on.
# PORTFOLIO_PORT=8742

# Absolute path to the PWA folder to serve at /. Auto-discovered as
# ../pwa relative to server.py, so override only for non-standard layouts.
# PORTFOLIO_PWA_DIR=C:\path\to\StockInsights\pwa
